{
  "name": "@rig/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "rig": "dist/rig.mjs"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/rig.mjs && esbuild src/sandbox-child.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/sandbox.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:int": "pnpm build && vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@rig/dsp-host": "workspace:*",
    "@rig/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2"
  }
}
